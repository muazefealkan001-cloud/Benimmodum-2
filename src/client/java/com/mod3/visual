package com.mod3;

import net.fabricmc.api.ClientModInitializer;
import net.fabricmc.fabric.api.client.event.lifecycle.v1.ClientTickEvents;
import net.fabricmc.fabric.api.client.keybinding.v1.KeyBindingHelper;
import net.fabricmc.fabric.api.client.rendering.v1.hud.HudElementRegistry;
import net.fabricmc.fabric.api.client.rendering.v1.hud.VanillaHudElements;
import net.minecraft.client.KeyMapping;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.GuiGraphics;
import net.minecraft.client.gui.components.Button;
import net.minecraft.client.gui.screens.Screen;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.Identifier;
import net.minecraft.world.phys.HitResult;
import org.lwjgl.glfw.GLFW;

import java.util.ArrayDeque;
import java.util.Deque;

public class Nexus implements ClientModInitializer {

    private static KeyMapping menuKey;

    private static final boolean[] on = {
        true,  // 0 Hit Counter
        true,  // 1 Hit Timer
        true,  // 2 Combo Counter
        true,  // 3 Attack Stats
        true,  // 4 CPS
        false, // 5 Aim Trainer (henuz bir isi yok)
        true,  // 6 HUD basligi
        true,  // 7 FPS
        true,  // 8 Koordinat
        true,  // 9 Armor
        false  // 10 Sprint
    };

    private static final String[] NAMES = {
        "Hit Counter", "Hit Timer", "Combo Counter", "Attack Stats", "CPS",
        "Aim Trainer", "HUD", "FPS", "Coordinates", "Armor HUD", "Sprint"
    };

    private static final String[] CATS = {"Combat", "Render", "Movement", "Utility"};

    private static int hits = 0;
    private static int combo = 0;
    private static long lastHit = 0;
    private static boolean wasDown = false;
    private static final Deque<Long> clicks = new ArrayDeque<>();

    @Override
    public void onInitializeClient() {
        KeyMapping.Category cat = KeyMapping.Category.register(
            Identifier.fromNamespaceAndPath("nexus", "main"));
        menuKey = KeyBindingHelper.registerKeyBinding(
            new KeyMapping("key.nexus.menu", GLFW.GLFW_KEY_RIGHT_SHIFT, cat));

        ClientTickEvents.END_CLIENT_TICK.register(mc -> {
            while (menuKey.consumeClick()) {
                mc.setScreen(new NexusGUI());
            }
            if (mc.player == null) return;

            if (on[10]) mc.player.setSprinting(true);

            boolean down = mc.options.keyAttack.isDown();
            if (down && !wasDown && mc.screen == null) {
                registerClick();
                if (mc.hitResult != null
                        && mc.hitResult.getType() == HitResult.Type.ENTITY) {
                    registerHit();
                }
            }
            wasDown = down;

            if (mc.player.hurtTime > 0) combo = 0;
        });

        HudElementRegistry.attachElementAfter(
            VanillaHudElements.MISC_OVERLAYS,
            Identifier.fromNamespaceAndPath("nexus", "hud"),
            (graphics, tickCounter) -> renderHud(graphics)
        );
    }

    private static void registerClick() {
        long now = System.currentTimeMillis();
        clicks.addLast(now);
        trimClicks(now);
    }

    private static void registerHit() {
        hits++;
        combo++;
        lastHit = System.currentTimeMillis();
    }

    private static void trimClicks(long now) {
        while (!clicks.isEmpty() && now - clicks.peekFirst() > 1000) {
            clicks.removeFirst();
        }
    }

    private static int getCps() {
        trimClicks(System.currentTimeMillis());
        return clicks.size();
    }

    private static void line(GuiGraphics g, String s, int y, int color) {
        g.drawString(Minecraft.getInstance().font, s, 10, y, color, true);
    }

    private static void renderHud(GuiGraphics g) {
        Minecraft mc = Minecraft.getInstance();
        if (mc.player == null || mc.options.hideGui) return;

        int y = 10;
        if (on[6]) { line(g, "NEXUS 1.3", y, 0xFFB56CFF); y += 13; }
        if (on[7]) { line(g, "FPS: " + mc.getFps(), y, 0xFFFFFFFF); y += 13; }
        if (on[4]) { line(g, "CPS: " + getCps(), y, 0xFFFFFFFF); y += 13; }
        if (on[0]) { line(g, "HITS: " + hits, y, 0xFFFFFFFF); y += 13; }
        if (on[2]) { line(g, "COMBO: " + combo, y, 0xFFB56CFF); y += 13; }
        if (on[1]) {
            String t = lastHit == 0 ? "--"
                : ((System.currentTimeMillis() - lastHit) / 1000) + "s";
            line(g, "LAST HIT: " + t, y, 0xFFFFFFFF); y += 13;
        }
        if (on[3]) { line(g, "ATTACK STATS: " + hits, y, 0xFFB56CFF); y += 13; }
        if (on[8]) {
            line(g, String.format("XYZ: %.1f %.1f %.1f",
                mc.player.getX(), mc.player.getY(), mc.player.getZ()),
                y, 0xFFFFFFFF);
            y += 13;
        }
        if (on[9]) {
            line(g, "ARMOR: " + mc.player.getArmorValue(), y, 0xFFFFFFFF);
        }
    }

    public static class NexusGUI extends Screen {

        private int category = 0;

        public NexusGUI() {
            super(Component.literal("NEXUS CLIENT"));
        }

        private boolean belongs(int i) {
            return switch (category) {
                case 0 -> i <= 5;
                case 1 -> i == 6 || i == 7;
                case 2 -> i == 10;
                case 3 -> i == 8 || i == 9;
                default -> false;
            };
        }

        @Override
        protected void init() {
            int x = width / 2 - 160;
            int y = height / 2 - 110;

            for (int c = 0; c < CATS.length; c++) {
                final int idx = c;
                String label = (c == category ? "> " : "") + CATS[c];
                addRenderableWidget(Button.builder(Component.literal(label), b -> {
                    category = idx;
                    rebuildWidgets();
                }).bounds(x + c * 80, y, 76, 20).build());
            }

            int row = 0;
            for (int i = 0; i < NAMES.length; i++) {
                if (!belongs(i)) continue;
                final int idx = i;
                String label = NAMES[i] + ": " + (on[i] ? "ON" : "OFF");
                addRenderableWidget(Button.builder(Component.literal(label), b -> {
                    on[idx] = !on[idx];
                    rebuildWidgets();
                }).bounds(x + 10, y + 35 + row * 26, 300, 20).build());
                row++;
            }
        }

        @Override
        public void render(GuiGraphics g, int mouseX, int mouseY, float delta) {
            super.render(g, mouseX, mouseY, delta);
            g.drawString(font, "NEXUS CLIENT 1.3",
                width / 2 - 50, height / 2 - 135, 0xFFB56CFF, true);
        }
    }
}
